# hk-watch-location.ps1 - 通过 USB/iAP2 向获批测试设备发送模拟坐标 [Windows 版]
#
#
# 用法（在 PowerShell 中执行）：
#   powershell -ExecutionPolicy Bypass -File .\hk-watch-location.ps1                    # 一键完整流程
#   powershell -ExecutionPolicy Bypass -File .\hk-watch-location.ps1 run 22.2810 114.1588  # 自定义坐标
#   powershell -ExecutionPolicy Bypass -File .\hk-watch-location.ps1 send               # 跳过安装步骤直接发送
#   powershell -ExecutionPolicy Bypass -File .\hk-watch-location.ps1 stop               # 停止发送并恢复真实定位
#
# Windows 特有前提：
#   1. 已安装 iTunes（官网版）或 Microsoft Store 的"Apple Devices/设备"应用
#      —— 它提供 usbmuxd 服务（Apple Mobile Device Service，本地端口 27015），
#         pymobiledevice3 在 Windows 上依赖它访问 iPhone
#   2. iPhone 用数据线连接，已解锁并点击"信任此电脑"
#   3. 仅在获批的测试应用中触发定位请求

param(
    [Parameter(Position = 0)][string]$Command = "run",
    [Parameter(Position = 1)][double]$Latitude = 22.3193,   # 纬度
    [Parameter(Position = 2)][double]$Longitude = 114.1694, # 经度
    [int]$Duration = 900                                    # 单轮会话时长（秒）；发送循环执行，直到用户按 Ctrl+C 手动停止
)

# ========================= 可配置参数 =========================
# 组件包：主包（accessory-location 脚本/源码 + identity MFi 证书）
#          + 按平台独立的 lib 包（依赖 wheel），Windows 固定使用 win-amd64
$BundleDir   = Join-Path $env:USERPROFILE "hk-watch-location-bundle"
$BaseUrl     = "https://github.com/siruoren/hk-watch-location/releases/download/v1"
$BundleUrl   = "$BaseUrl/hk-watch-location-bundle.zip"
$BundleSha256 = "28751D17D466B3EE2D5A0646E96CAD3B5EC7206A48BD84CF68916C997684528E"
$LibName     = "hk-watch-location-lib-win-amd64.zip"
$LibUrl      = "$BaseUrl/$LibName"
$LibSha256   = "53C7C8D7EE722CE35AFE6F3DD7D86396A841B3C2646292418EABF59F36023E15"
$PyPiMirror  = "https://pypi.tuna.tsinghua.edu.cn/simple"
# GitHub 加速代理地址（按顺序尝试，全部失效后才回退 GitHub 直连）
$GhMirrors     = @("https://ghfast.top/", "https://wget.la/", "https://gh-proxy.com/", "https://ghproxy.net/", "https://ghproxy.cc/", "https://gh-proxy.net/")
# 整个代理列表的完整轮次：代理全部失败 -> 直连 -> 仍失败再来一轮
$DownloadRounds = 2
$SendLog     = Join-Path $env:TEMP "send_hk.log"

function Write-Info { param($m) Write-Host "[信息] $m" -ForegroundColor Cyan }
function Write-Ok   { param($m) Write-Host "[完成] $m" -ForegroundColor Green }
function Write-Warn2{ param($m) Write-Host "[注意] $m" -ForegroundColor Yellow }
function Write-Err2 { param($m) Write-Host "[错误] $m" -ForegroundColor Red }

# ========================= 子命令：stop =========================
function Invoke-Stop {
    Write-Info "停止所有发送进程..."
    Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
        Where-Object { $_.CommandLine -match "accessory-location send|local_mfi_v3_helper" } |
        ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
    Start-Sleep -Seconds 1

    $left = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
        Where-Object { $_.CommandLine -match "accessory-location send|local_mfi_v3_helper" }
    if ($left) { Write-Err2 "仍有进程残留，请到任务管理器手动结束 python 进程" }
    else { Write-Ok "发送进程已全部停止，USB 会话已断开" }

    Write-Host ""
    Write-Warn2 "恢复手机真实定位，请在 iPhone 上操作："
    Write-Host "  1. 拔掉 USB 线"
    Write-Host "  2. 设置 - 隐私与安全性 - 定位服务 - 关闭 10 秒后再打开"
    Write-Host "  3. 打开地图重新定位，确认蓝点回到真实位置"
}

# ========================= 步骤 1：环境检查 =========================
# 自动安装 Apple Devices 应用（提供 usbmuxd 服务；winget 官网渠道优先，Store 渠道兜底）
# 返回 $true 表示端口 27015 已就绪；$false 表示需要用户手动处理
function Install-AppleDevices {
    Write-Warn2 "未检测到 usbmuxd 服务，尝试自动安装 Apple Devices 应用..."
    if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
        Write-Err2 "winget 不可用（Windows 10 1809 以下或未安装 App Installer），无法自动安装"
        return $false
    }

    # 渠道 1：winget 社区源（Apple 官网安装包，无需商店登录）
    winget install --id Apple.AppleDevices -e --accept-package-agreements --accept-source-agreements
    # 渠道 2：Microsoft Store 源（Apple Devices 应用 ID）
    if ($LASTEXITCODE -ne 0) {
        Write-Warn2 "官网渠道安装失败或已存在，改用 Microsoft Store 渠道..."
        winget install --id 9NP83LWLPZ9S -e --source msstore --accept-package-agreements --accept-source-agreements
        if ($LASTEXITCODE -ne 0) {
            Write-Err2 "Apple Devices 自动安装失败，请手动安装后重试"
            return $false
        }
    }
    Write-Ok "Apple Devices 应用安装完成"

    # 启动 Apple Mobile Device Service（usbmuxd）
    Start-Sleep -Seconds 5
    $svc = Get-Service "Apple Mobile Device Service" -ErrorAction SilentlyContinue
    if ($svc) {
        if ($svc.StartType -eq 'Disabled') {
            Set-Service "Apple Mobile Device Service" -StartupType Automatic
        }
        if ($svc.Status -ne 'Running') {
            Start-Service "Apple Mobile Device Service" -ErrorAction SilentlyContinue
        }
        Write-Ok "Apple Mobile Device Service 状态：$((Get-Service 'Apple Mobile Device Service').Status)"
    } else {
        Write-Warn2 "未找到 Apple Mobile Device Service（可能需要重启电脑完成安装）"
    }

    # 等待端口 27015 就绪（最多 60 秒）
    Write-Info "等待 usbmuxd 监听端口 27015..."
    for ($i = 1; $i -le 12; $i++) {
        Start-Sleep -Seconds 5
        if (Get-NetTCPConnection -LocalPort 27015 -State Listen -ErrorAction SilentlyContinue) {
            return $true
        }
    }
    Write-Err2 "等待 60 秒后端口 27015 仍未监听，建议重启电脑后重新运行本脚本"
    return $false
}

function Step-CheckEnv {
    Write-Info "步骤 1/5：检查环境"

    # uv 检查/安装
    if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
        Write-Warn2 "未安装 uv，正在安装..."
        Invoke-RestMethod https://astral.sh/uv/install.ps1 | Invoke-Expression
        $env:Path = "$env:Path;$env:USERPROFILE\.local\bin"
    }
    if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
        Write-Err2 "uv 安装失败或未加入 PATH，请关闭并重新打开 PowerShell 后再试"; exit 1
    }
    Write-Ok "uv $( (uv --version) -replace '.*?(\d[\d.]+.*)$', '$1' )"

    # usbmuxd 服务检查（Windows 必需：iTunes / Apple Devices 应用提供）
    $usbmuxd = Get-NetTCPConnection -LocalPort 27015 -State Listen -ErrorAction SilentlyContinue
    if ($usbmuxd) {
        Write-Ok "usbmuxd 服务已就绪（本地端口 27015）"
    } else {
        # Apple Devices 应用不存在时自动安装（winget 官网渠道 -> Store 渠道），失败再退回手动
        if (Install-AppleDevices) {
            Write-Ok "usbmuxd 服务已就绪（本地端口 27015）"
        } else {
            Write-Warn2 "usbmuxd 仍未就绪！请手动安装 iTunes（官网版）或 Microsoft Store 的 Apple Devices 应用，必要时重启电脑"
            Read-Host "已安装则按回车继续，或 Ctrl-C 退出"
        }
    }

    # iPhone USB 检测
    $iphone = Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue |
        Where-Object { $_.FriendlyName -match "iPhone|iPad|Apple Mobile Device" }
    if ($iphone) { Write-Ok "检测到 iPhone 已通过 USB 连接" }
    else {
        Write-Warn2 "未检测到 iPhone！请确认：已用数据线连接、已解锁、已点'信任此电脑'"
        Read-Host "按回车继续，或 Ctrl-C 退出"
    }
}

# ========================= 步骤 2：下载组件包 =========================
# 通用下载：Invoke-Fetch <URL> <目标文件> <最小字节数> [超时秒数，默认900，lib包传3600=1小时]
# 每轮先遍历全部代理，单个代理超时/失败自动换下一个；代理全部失效后回退 GitHub 直连；
# 仍失败再来一轮，共 $DownloadRounds 轮；全部失败返回 $false，由调用方决定降级（如在线安装）
function Invoke-Fetch {
    param([string]$Url, [string]$Dest, [long]$MinSize, [int]$TimeoutSec = 900)
    $ok = $false
    for ($round = 1; $round -le $DownloadRounds; $round++) {
        if ($round -gt 1) { Write-Warn2 "上一轮下载全部失败，开始第 $round 轮重试..." }
        foreach ($m in $GhMirrors) {
            Write-Info "  代理尝试: $m（单次超时 $TimeoutSec 秒）"
            Remove-Item $Dest -Force -ErrorAction SilentlyContinue
            curl.exe -sL --connect-timeout 15 --max-time $TimeoutSec --retry 3 --retry-delay 2 -o $Dest "$m$Url"
            if ((Test-Path $Dest) -and ((Get-Item $Dest).Length -gt $MinSize)) {
                $ok = $true
                Write-Ok "  下载成功 ($((Get-Item $Dest).Length) 字节)"; break
            }
        }
        if (-not $ok) {
            Write-Warn2 "全部代理失效（超时或失败），回退 GitHub 直连..."
            Remove-Item $Dest -Force -ErrorAction SilentlyContinue
            curl.exe -sL --connect-timeout 15 --max-time $TimeoutSec --retry 3 --retry-delay 2 -o $Dest $Url
            if ((Test-Path $Dest) -and ((Get-Item $Dest).Length -gt $MinSize)) {
                $ok = $true
                Write-Ok "  直连下载成功 ($((Get-Item $Dest).Length) 字节)"
            }
        }
        if ($ok) { break }
    }
    if (-not $ok) {
        Remove-Item $Dest -Force -ErrorAction SilentlyContinue   # 清理残留的部分下载文件
        Write-Err2 "代理与直连共 $DownloadRounds 轮重试均失败（每次超时 $TimeoutSec 秒），请手动下载 $Url 后重试"
        return $false
    }
    return $true
}

# 校验 SHA-256：Assert-Hash <文件> <期望SHA256>
function Assert-Hash {
    param([string]$File, [string]$Expected)
    $actual = (Get-FileHash $File -Algorithm SHA256).Hash
    if ($actual -ne $Expected) {
        Write-Err2 "SHA-256 不匹配！期望 $Expected，实际 $actual（文件：$File）"; exit 1
    }
    Write-Ok "SHA-256 校验通过：$(Split-Path $File -Leaf)"
}

# 主包是否就绪（脚本 + 证书；lib 可缺失，缺时依赖走在线安装）
function Test-BundleReady {
    return (Test-Path (Join-Path $BundleDir "accessory-location\tools\local_mfi_v3_helper.py")) `
        -and (Test-Path (Join-Path $BundleDir "identity\certificate.p7b")) `
        -and (Test-Path (Join-Path $BundleDir "identity\identity.pk8"))
}

function Test-LibReady {
    return ((Get-ChildItem (Join-Path $BundleDir "lib\*.whl") -ErrorAction SilentlyContinue | Measure-Object).Count -gt 0)
}

function Step-SetupBundle {
    Write-Info "步骤 2/5：准备组件包（脚本 + 证书 + win-amd64 lib）"

    if (Test-Path (Join-Path $BundleDir ".venv\Scripts\accessory-location.exe")) {
        Write-Ok "组件包与依赖已就绪：$BundleDir"; return
    }

    # --- 主包（脚本 + 证书），下载失败则无法继续 ---
    if (-not (Test-BundleReady)) {
        $bundleZip = Join-Path $env:TEMP "hk-watch-location-bundle.zip"
        if (-not (Test-Path $bundleZip)) {
            Write-Info "下载主组件包（脚本 + 证书）..."
            if (-not (Invoke-Fetch $BundleUrl $bundleZip 50000)) {
                Remove-Item $bundleZip -Force -ErrorAction SilentlyContinue
                Write-Err2 "主组件包下载失败，请检查网络或手动下载 $BundleUrl 后重试"; exit 1
            }
        }
        Assert-Hash $bundleZip $BundleSha256
        Write-Info "解压主组件包到 $BundleDir ..."
        New-Item $BundleDir -ItemType Directory -Force | Out-Null
        Expand-Archive -Path $bundleZip -DestinationPath $BundleDir -Force
        if (-not (Test-BundleReady)) {
            Write-Err2 "主组件包解压后不完整（缺 accessory-location / identity）"; exit 1
        }
        Write-Ok "主组件包就绪：$BundleDir（证书已随包提供，无需再解析 APK）"
    } else { Write-Ok "主组件包已存在：$BundleDir" }

    # --- win-amd64 lib 包；网络持续不可用时跳过，由步骤 3 自动在线安装依赖 ---
    if (-not (Test-LibReady)) {
        $libZip = Join-Path $env:TEMP $LibName
        if (-not (Test-Path $libZip)) {
            Write-Info "下载 lib 包：$LibName ..."
            if (-not (Invoke-Fetch $LibUrl $libZip 10000000 3600)) {
                Write-Warn2 "lib 包下载失败（网络不可用），将改为在线安装依赖"
                Remove-Item $libZip -Force -ErrorAction SilentlyContinue
                return
            }
        } else {
            Assert-Hash $libZip $LibSha256
        }
        Write-Info "解压 lib 包到 $BundleDir\lib ..."
        New-Item (Join-Path $BundleDir "lib") -ItemType Directory -Force | Out-Null
        Expand-Archive -Path $libZip -DestinationPath (Join-Path $BundleDir "lib") -Force
        if (-not (Test-LibReady)) {
            Write-Warn2 "lib 包解压异常，将改为在线安装依赖"
            Remove-Item (Join-Path $BundleDir "lib") -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
}

# ========================= 步骤 3：安装依赖（优先 lib\ 离线，缺 lib 时在线） =========================
function Step-SetupDeps {
    Write-Info "步骤 3/5：安装依赖（Python 3.12）"

    $env:UV_PYTHON_INSTALL_MIRROR = "https://ghfast.top/https://github.com/astral-sh/python-build-standalone/releases/download"
    $venvExe = Join-Path $BundleDir ".venv\Scripts\accessory-location.exe"
    $venvDir = Join-Path $BundleDir ".venv"

    if (-not (Test-Path $venvExe)) {
        if (Test-Path $venvDir) { Remove-Item $venvDir -Recurse -Force }
        uv venv --python 3.12 $venvDir
        if (Test-LibReady) {
            # 优先纯离线安装（lib\ 内含本平台全部 wheel）
            uv pip install --python $venvDir --no-index `
                --find-links (Join-Path $BundleDir "lib") accessory-location==0.1.0
            if ($LASTEXITCODE -ne 0) {
                Write-Warn2 "离线安装失败，改用镜像在线补齐缺失组件..."
                $env:UV_HTTP_TIMEOUT = "600"
                $env:UV_INDEX_URL    = $PyPiMirror
                uv pip install --python $venvDir (Join-Path $BundleDir "accessory-location")
            }
        } else {
            # lib 包未下载成功（网络不可用）：直接在线安装（包内源码 + 镜像拉依赖）
            Write-Warn2 "lib\ 无 wheel，改为在线安装依赖（使用清华镜像）..."
            $env:UV_HTTP_TIMEOUT = "600"
            $env:UV_INDEX_URL    = $PyPiMirror
            uv pip install --python $venvDir (Join-Path $BundleDir "accessory-location")
        }
    }
    & (Join-Path $BundleDir ".venv\Scripts\python.exe") -c "import cryptography, pymobiledevice3"
    if ($LASTEXITCODE -eq 0) { Write-Ok "依赖安装并导入验证通过" }
}

# ========================= 步骤 4：发送坐标 =========================
function Invoke-Send {
    Write-Info "步骤 4/5：发送坐标 ($Latitude, $Longitude)，会话 $Duration 秒"

    New-Item (Join-Path $env:USERPROFILE ".pymobiledevice3") -ItemType Directory -Force | Out-Null

    if (-not (Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue |
            Where-Object { $_.FriendlyName -match "iPhone|iPad|Apple Mobile Device" })) {
        Write-Err2 "未检测到 iPhone，请连接 USB 后重试"; exit 1
    }

    # 证书/私钥直接使用组件包内的 identity 目录
    $env:ACCESSORY_MFI_CERT_FILE = Join-Path $BundleDir "identity\certificate.p7b"
    $env:ACCESSORY_MFI_KEY_FILE  = Join-Path $BundleDir "identity\identity.pk8"

    # 生成认证助手 shim（让 venv 的 Python 执行包内 helper 脚本）
    $shim = Join-Path $BundleDir "accessory-location\tools\local_mfi_v3_helper.cmd"
    "@echo off`r`n`"%~dp0..\..\.venv\Scripts\python.exe`" `"%~dp0local_mfi_v3_helper.py`" %*" |
        Set-Content -Path $shim -Encoding ASCII

    Write-Info "启动 USB 会话，日志：$SendLog"
    Write-Host "-----------------------------------------------------------"
    Write-Warn2 "请仅在获批的测试应用中触发定位请求；不要用于改变真实位置或获取受限服务资格"
    Write-Host "-----------------------------------------------------------"

    Push-Location (Join-Path $BundleDir "accessory-location")
    try {
        # 持续运行：每轮 $Duration 秒，轮与轮无缝衔接，直到用户按 Ctrl+C 手动停止
        # Ctrl+C 结束会话后 accessory-location 以非零码退出，据此终止循环（finally 仍会执行结果解读）
        Set-Content -Path $SendLog -Value $null   # 每次执行重建日志（多轮 Tee-Object -Append 累加）
        $round = 1
        while ($true) {
            Write-Info "第 $round 轮发送会话（$Duration 秒/轮，按 Ctrl+C 随时停止）"
            & (Join-Path $BundleDir ".venv\Scripts\accessory-location.exe") send --transport usb `
                --auth-helper $shim `
                --latitude $Latitude --longitude $Longitude --duration $Duration 2>&1 |
                Tee-Object -FilePath $SendLog -Append
            if ($LASTEXITCODE -ne 0) { break }
            $round++
        }
        Write-Ok "发送已手动停止（共完成 $round 轮，日志：$SendLog）"
    } finally { Pop-Location }
}

# ========================= 步骤 5：结果解读 =========================
function Step-Report {
    Write-Info "步骤 5/5：会话结果解读"
    Write-Host ""

    if (-not (Test-Path $SendLog)) { Write-Err2 "无日志文件"; return }
    $log = Get-Content $SendLog -Raw

    if ($log -match "authentication_succeeded") { Write-Ok "MFi 认证成功" }
    else { Write-Err2 "未见认证成功事件，检查证书与 USB 连接" }

    if ($log -match "location_requested") { Write-Ok "手机已发起定位请求（订阅 GGA+RMC）" }
    else { Write-Warn2 "未收到定位请求 -> 请检查获批测试应用及 USB 会话状态" }

    $ack = 0
    foreach ($m in [regex]::Matches($log, '"location_link_acknowledged", "count": (\d+)')) {
        $ack = [int]$m.Groups[1].Value
    }
    if ($ack -gt 0) { Write-Ok "手机确认收到 $ack 个坐标包（送达≠采纳，以地图蓝点为准）" }
    else { Write-Warn2 "无确认包，检查手机端操作" }

    Write-Host ""
    Write-Info "测试结束后运行 .\hk-watch-location.ps1 stop，并确认设备已恢复真实定位。"
    Write-Warn2 "坐标包送达不代表系统或应用采纳，也不代表任何服务资格。"
}

# ========================= 主流程 =========================
switch ($Command) {
    "stop"  { Invoke-Stop }
    "send"  {
        if (-not (Test-BundleReady)) { Write-Err2 "主组件包未就绪，请先执行完整流程: run"; exit 1 }
        if (-not (Test-Path (Join-Path $BundleDir ".venv\Scripts\accessory-location.exe"))) {
            Write-Err2 "依赖未安装，请先执行完整流程: run"; exit 1
        }
        New-Item (Join-Path $env:USERPROFILE ".pymobiledevice3") -ItemType Directory -Force | Out-Null
        Invoke-Send; Step-Report
    }
    "run"   {
        Step-CheckEnv
        Step-SetupBundle
        Step-SetupDeps
        Invoke-Send
        Step-Report
    }
    default {
        Write-Host "用法: .\hk-watch-location.ps1 [run|send|stop] [纬度] [经度]"
        Write-Host "  run  (默认) 完整流程：环境检查 -> 下载组件包 -> 离线装依赖 -> 持续发送（Ctrl+C 停止）"
        Write-Host "  send        直接持续发送（跳过安装步骤，Ctrl+C 停止）"
        Write-Host "  stop        停止发送并指导恢复真实定位"
    }
}
